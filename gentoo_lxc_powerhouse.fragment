# =====================================================================
# HARD INVARIANT — DO NOT MODIFY THIS FILE
# =====================================================================
#
# This defconfig is a KNOWN-GOOD, BOOTING BASELINE for:
#   - Pixel 6 (Raviole)
#   - Full LXC / container / namespace support
#   - Custom KABI patches already applied
#
# THIS FILE IS NOT A TUNING TARGET.
# THIS FILE IS NOT A DEBUG SURFACE.
#
# DO NOT:
#   - Disable options here
#   - Remove options here
#   - "Clean up" or "minimize" this file
#   - Guess which options are unnecessary
#
# BOOT LOOP DEBUGGING RULE:
#   - If a boot loop occurs, the cause IS NOT in this file
#   - DO NOT attempt to fix boot loops by editing this defconfig
#
# CORRECT WORKFLOW:
#   1. LEAVE THIS FILE COMPLETELY UNCHANGED
#   2. Create or update a SEPARATE *.fragment file
#   3. Enable/disable options ONLY in the fragment
#   4. Iterate gradually until the failure is isolated
#
# AI CODER CONSTRAINT:
#   - You are not permitted to edit this file
#   - You must request or create a fragment instead
#
# This rule exists because editing this file has already destroyed
# known-working configurations and wasted significant debugging time.
#
# THIS FILE IS EFFECTIVELY READ-ONLY.
# =====================================================================

# IPC (requires KABI patch for user_struct)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces (full set)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# Cgroups (full set - KABI patches allow these now)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y

# Container networking
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_NPT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Filesystems
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y

# Networking
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_UNIX=y

# Device management
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Optional features
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_KEYS=y

# =============================================================================
# LXC ENHANCED CONFIGS - Verified working 2024-12-16
# =============================================================================

# Advanced Virtual Network Devices
# MACVLAN: Virtual interfaces with unique MAC addresses for containers
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
# IPVLAN: SKIPPED - causes bootloop, MACVLAN provides equivalent functionality
# VXLAN/GENEVE: Overlay networks for Docker Swarm/K8s multi-host networking
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_DUMMY=y

# Enhanced Netfilter/NAT
# Full IPv4/IPv6 NAT, masquerade, port forwarding for containers
# Connection tracking for stateful firewalling
# Mangle tables for packet modification (QoS, marking)
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_EGRESS=y
CONFIG_NF_CONNTRACK_BRIDGE=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y

# nftables - Modern iptables replacement
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y

# Enhanced Cgroups - Memory/IO accounting for containers
CONFIG_MEMCG_KMEM=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BFQ_GROUP_IOSCHED=y

# Enhanced Filesystems - OverlayFS, FUSE, Squashfs for container images
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y

# Audit, Performance, Misc
# Audit: syscall auditing for security monitoring
# THP: Transparent Huge Pages for better memory performance
# KSM: Memory deduplication across containers (saves RAM)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_KSM=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_WIREGUARD=y
CONFIG_HW_RANDOM=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_BPF_SYSCALL=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
