# =============================================================================
# Linux Backports Aspirations
# =============================================================================
# TEAM_022: Security hardening configs for password manager use case
#
# STATUS: Configs to be tested incrementally
# ACTION: Add configs to linux_backports.fragment and test boot
#
# Use Case: Gentoo LXC powerhouse server running password manager (Vaultwarden)
# Goal: Maximum memory protection for sensitive data (master keys, passwords)
#
# =============================================================================

# =============================================================================
# CATEGORY S1: SECRET MEMORY (CRITICAL for password managers)
# =============================================================================
# memfd_secret() syscall - memory invisible to kernel direct map
# Perfect for storing master keys and decrypted passwords
# Kernel cannot read this memory even with root access
CONFIG_SECRETMEM=y

# =============================================================================
# CATEGORY S2: MEMORY ZEROING (CRITICAL for sensitive data)
# =============================================================================
# Zero all heap memory when freed - prevents password recovery from freed memory
# Blocks cold boot attacks on freed allocations
# ~3-5% performance impact (worth it for security)
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Zero all heap memory on allocation - prevents uninitialized memory disclosure
# <1% performance impact
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# Zero-initialize all stack variables - prevents stack-based info leaks
# Requires compiler support (Clang has this)
CONFIG_INIT_STACK_ALL_ZERO=y

# =============================================================================
# CATEGORY S3: COLD BOOT ATTACK MITIGATION
# =============================================================================
# Wipes RAM via EFI on reboot - prevents physical cold boot attacks
CONFIG_RESET_ATTACK_MITIGATION=y

# =============================================================================
# CATEGORY S4: HEAP HARDENING (Anti-exploitation)
# =============================================================================
# Randomize slab freelist order - makes heap exploitation harder
CONFIG_SLAB_FREELIST_RANDOM=y

# Harden slab freelist metadata - detects corruption
CONFIG_SLAB_FREELIST_HARDENED=y

# Randomize page allocator - makes heap spraying harder
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# Sampling-based heap out-of-bounds and use-after-free detection
# Low overhead runtime protection
CONFIG_KFENCE=y

# =============================================================================
# CATEGORY S5: BUFFER OVERFLOW PROTECTION
# =============================================================================
# Bounds checking on copy_to_user/copy_from_user
CONFIG_HARDENED_USERCOPY=y

# Compile-time buffer overflow detection
CONFIG_FORTIFY_SOURCE=y

# =============================================================================
# CATEGORY S6: MEMORY PROTECTION
# =============================================================================
# Sanity checks on page table mappings
CONFIG_PAGE_TABLE_CHECK=y

# Prevent direct physical memory access
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# =============================================================================
# CATEGORY S7: STACK PROTECTION
# =============================================================================
# Stack canaries for buffer overflow detection
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# =============================================================================
# CATEGORY S8: ASLR IMPROVEMENTS
# =============================================================================
# Kernel address space layout randomization
CONFIG_RANDOMIZE_BASE=y

# Randomize kernel stack offset on syscall entry
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# =============================================================================
# CATEGORY S9: ARM64 HARDWARE SECURITY (if supported by Tensor G1)
# =============================================================================
# Pointer Authentication (ARMv8.3+)
CONFIG_ARM64_PTR_AUTH=y

# Shadow Call Stack - return address protection
CONFIG_SHADOW_CALL_STACK=y

# =============================================================================
# NOTES
# =============================================================================
# Some configs may already be enabled in gki_defconfig - that's OK, fragments
# can reinforce them.
#
# Tensor G1 (Pixel 6) is ARMv8.2, so some ARMv8.5+ features like MTE won't work.
# PTR_AUTH and SHADOW_CALL_STACK should be available.
#
# Testing strategy:
#   1. Try ALL configs at once
#   2. If build fails, bisect by category
#   3. If boot fails, bisect by category
