# =============================================================================
# Linux Backports Fragment
# =============================================================================
# TEAM_001: Configs for backported features from newer kernels
#
# This fragment enables kernel features that have been backported from newer
# Linux versions (6.6+, 6.12) to this 6.1 kernel.
#
# Workflow:
#   1. Add configs to linux_backports.aspirations (wishlist)
#   2. Test incrementally by adding to this fragment
#   3. Update linux_backports.last_working after each successful boot
#
# =============================================================================

# =============================================================================
# CATEGORY C: MEMORY MANAGEMENT BACKPORTS
# =============================================================================

# C1: Folio Helpers - Memory management helper functions
# Backported: folio_zero_tail, folio_fill_tail, memcpy_from/to_folio
# Benefits: Filesystem performance, efficient tail page handling
# Config: No additional config needed - pure code additions

# C2: MGLRU Fixes - Multi-Gen LRU correctness improvements
# Backported: set_initial_priority, nodemask handling, generation aging
# Benefits: Better memory reclaim, fair container memory distribution
# Note: LRU_GEN already enabled in gki_defconfig, but we set it explicitly
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# C3: OOM/Reclaim Robustness - OOM killer improvements
# Backported: Correct victim selection, clean teardown under pressure
# Benefits: System stability, OOM respects cgroup boundaries
# Config: No additional config needed - improvements to existing code

# =============================================================================
# CATEGORY S: SECURITY HARDENING (Password Manager Use Case)
# =============================================================================
# TEAM_022: Security configs for Vaultwarden/password manager protection
# Goal: Maximum memory protection for sensitive data (master keys, passwords)

# -----------------------------------------------------------------------------
# S1: SECRET MEMORY - AUTO-ENABLED
# -----------------------------------------------------------------------------
# CONFIG_SECRETMEM is def_bool (auto-selected when ARCH_HAS_SET_DIRECT_MAP)
# memfd_secret() syscall will be available if arch supports it
# No manual config needed

# -----------------------------------------------------------------------------
# S2: MEMORY ZEROING (CRITICAL for sensitive data)
# -----------------------------------------------------------------------------
# Zero heap memory when freed - prevents password recovery
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Zero heap memory on allocation - prevents info leaks
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# Zero-initialize all stack variables
CONFIG_INIT_STACK_ALL_ZERO=y

# -----------------------------------------------------------------------------
# S3: COLD BOOT ATTACK MITIGATION
# -----------------------------------------------------------------------------
# Wipes RAM via EFI on reboot
CONFIG_RESET_ATTACK_MITIGATION=y

# -----------------------------------------------------------------------------
# S4: HEAP HARDENING
# -----------------------------------------------------------------------------
# Randomize slab freelist order
CONFIG_SLAB_FREELIST_RANDOM=y

# Harden slab freelist metadata
CONFIG_SLAB_FREELIST_HARDENED=y

# Randomize page allocator
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# Heap out-of-bounds and use-after-free detection
CONFIG_KFENCE=y

# -----------------------------------------------------------------------------
# S5: BUFFER OVERFLOW PROTECTION
# -----------------------------------------------------------------------------
# Bounds checking on copy_to_user/copy_from_user
CONFIG_HARDENED_USERCOPY=y

# Compile-time buffer overflow detection
CONFIG_FORTIFY_SOURCE=y

# -----------------------------------------------------------------------------
# S6: MEMORY PROTECTION
# -----------------------------------------------------------------------------
# Sanity checks on page table mappings
CONFIG_PAGE_TABLE_CHECK=y

# STRICT_DEVMEM/IO_STRICT_DEVMEM - Not available on this platform
# (depends on ARCH_HAS_DEVMEM_IS_ALLOWED which is not set for arm64 mobile)

# -----------------------------------------------------------------------------
# S7: STACK PROTECTION
# -----------------------------------------------------------------------------
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# -----------------------------------------------------------------------------
# S8: ASLR IMPROVEMENTS
# -----------------------------------------------------------------------------
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# -----------------------------------------------------------------------------
# S9: ARM64 HARDWARE SECURITY
# -----------------------------------------------------------------------------
# Pointer Authentication (ARMv8.3+)
CONFIG_ARM64_PTR_AUTH=y

# Shadow Call Stack - return address protection
CONFIG_SHADOW_CALL_STACK=y