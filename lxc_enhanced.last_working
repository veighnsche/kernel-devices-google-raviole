# LXC Enhanced Fragment - LAST WORKING
# TEAM_001: Verified configs that boot successfully
#
# gentoo_lxc_powerhouse.fragment = WORKING baseline

# Test group A: MACVLAN only (PASSED)
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y

# Test group C: VXLAN/GENEVE/DUMMY (PASSED)
# VXLAN: Docker Swarm/K8s multi-host overlay networks
# GENEVE: Modern VXLAN alternative (OVN, cloud providers)
# DUMMY: Loopback-like interfaces for testing/routing
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_DUMMY=y

# Test group D: Enhanced Netfilter/NAT (PASSED)
# Full IPv4/IPv6 NAT, masquerade, port forwarding for containers
# Connection tracking for stateful firewalling
# Mangle tables for packet modification (QoS, marking)
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_EGRESS=y
CONFIG_NF_CONNTRACK_BRIDGE=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
