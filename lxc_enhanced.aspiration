# LXC Enhanced Configs - FUTURE ACTIVATION
# TEAM_001: All researched configs for full LXC/Docker support
#
# STATUS: These configs caused bootloop when added to gentoo_lxc_powerhouse.fragment
# ACTION: Need to bisect and test incrementally to find problematic config(s)
#
# BASELINE: gentoo_lxc_powerhouse.fragment is WORKING and includes:
#   - IPC: SYSVIPC, POSIX_MQUEUE
#   - Namespaces: NAMESPACES, UTS_NS, TIME_NS, NET_NS, PID_NS, IPC_NS, USER_NS
#   - Cgroups: CGROUPS, MEMCG, BLK_CGROUP, CGROUP_WRITEBACK, CGROUP_SCHED,
#              FAIR_GROUP_SCHED, CGROUP_FREEZER, CPUSETS, CGROUP_CPUACCT,
#              CGROUP_BPF, CGROUP_NET_PRIO, CGROUP_PIDS, CGROUP_DEVICE
#   - Networking: BRIDGE_NETFILTER, NETFILTER_ADVANCED, IP6_NF_NAT,
#                 IP6_NF_TARGET_MASQUERADE, IP6_NF_TARGET_NPT,
#                 NETFILTER_XT_TARGET_CHECKSUM, NETFILTER_XT_MATCH_ADDRTYPE,
#                 VETH, BRIDGE, TUN, UNIX
#   - Seccomp: SECCOMP, SECCOMP_FILTER
#   - Filesystems: OVERLAY_FS, TMPFS
#   - Device mgmt: DEVTMPFS, DEVTMPFS_MOUNT
#   - Optional: CHECKPOINT_RESTORE, KEYS

# =============================================================================
# PHASE 1: Advanced Virtual Network Devices (CAUSED BOOTLOOP - NEEDS BISECT)
# =============================================================================

# MAC-VLAN - Virtual interfaces mapping to specific MAC addresses
# Useful for giving containers their own MAC on the network
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y

# IP-VLAN - Virtual devices delivering packets based on L3 addresses
# More efficient than macvlan for many containers
CONFIG_IPVLAN=y
CONFIG_IPVLAN_L3S=y

# VXLAN - Virtual eXtensible LAN for overlay networks
# Used by Docker Swarm, Kubernetes for multi-host networking
CONFIG_VXLAN=y

# GENEVE - Generic Network Virtualization Encapsulation
# Modern alternative to VXLAN
CONFIG_GENEVE=y

# DUMMY - Dummy network interface
CONFIG_DUMMY=y

# =============================================================================
# PHASE 2: Enhanced Netfilter/NAT
# =============================================================================

# Netfilter ingress/egress hooks
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_EGRESS=y

# Bridge connection tracking
CONFIG_NF_CONNTRACK_BRIDGE=y

# NAT core
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y

# IPv4 NAT
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y

# Mangle tables (required for CHECKSUM target)
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y

# Additional XT targets
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# Additional XT matches
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y

# Connection tracking enhancements
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y

# =============================================================================
# PHASE 3: nftables (modern iptables replacement)
# =============================================================================

CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y

# =============================================================================
# PHASE 4: Enhanced Cgroups
# =============================================================================

# Memory cgroup kernel memory accounting
CONFIG_MEMCG_KMEM=y

# I/O scheduling for containers
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BFQ_GROUP_IOSCHED=y

# =============================================================================
# PHASE 5: Enhanced Filesystems
# =============================================================================

# OverlayFS enhancements
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y

# Tmpfs enhancements
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# FUSE for user-space filesystems
CONFIG_FUSE_FS=y

# Squashfs for read-only container images
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y

# =============================================================================
# PHASE 6: Security & Audit
# =============================================================================

# Audit system calls (may conflict with Android)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# =============================================================================
# PHASE 7: Performance Optimizations
# =============================================================================

# Transparent Huge Pages
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Memory compaction
CONFIG_COMPACTION=y

# KSM for memory deduplication across containers
CONFIG_KSM=y

# =============================================================================
# PHASE 8: Misc/Optional
# =============================================================================

# Bridge IGMP snooping
CONFIG_BRIDGE_IGMP_SNOOPING=y

# Wireguard (may already be in base)
CONFIG_WIREGUARD=y

# =============================================================================
# KNOWN ISSUES
# =============================================================================

# CONFIG_DEVTMPFS_SAFE=n is REQUIRED if you enable it
# It adds nosuid,noexec to /dev which breaks sudo in containers
# gentoo fragment already has DEVTMPFS_MOUNT=y without SAFE

# CONFIG_NETFILTER_XT_MATCH_IPVS depends on CONFIG_IP_VS (not enabled)
# Cannot enable without IP_VS base config

# =============================================================================
# TESTING NOTES
# =============================================================================

# 2024-12-16: Phase 1 (MACVLAN, MACVTAP, IPVLAN, VXLAN, GENEVE) caused bootloop
# Need to test each config individually to find culprit
# 
# Current test: MACVLAN + MACVTAP only in lxc_enhanced.fragment

# =============================================================================
# DOC-COVERAGE ADDON (missing from lxc_enhanced.future, but explicitly required in docs)
# Paste this block into lxc_enhanced.future.
# =============================================================================

# ---- PTY isolation / container SSH correctness (docs) ----
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# ---- Entropy + crypto accel on Tensor/Exynos path (docs) ----
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_EXYNOS=y
CONFIG_CRYPTO_DEV_EXYNOS=y

# ---- Storage inline crypto (docs: keep enabled) ----
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y

# ---- eBPF visibility + future-proof netfilter plumbing (docs) ----
CONFIG_BPF_SYSCALL=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
